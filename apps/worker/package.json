{
	"name": "@workspace/worker",
	"version": "0.2.19",
	"private": true,
	"license": "MIT",
	"scripts": {
		"dev": "tsx --env-file=../web/.env src/index.ts",
		"start": "tsx src/index.ts",
		"start:local": "tsx src/local-index.ts",
		"local:maps-one-shot": "tsx src/scripts/local-maps-one-shot.ts",
		"build": "tsc -p tsconfig.json",
		"check-types": "tsc --noEmit",
		"test": "tsx --test src/*.test.ts src/**/*.test.ts scripts/*.test.ts",
		"canary:brightdata-persisted": "SELENA_MEASUREMENT_RUN_MODE=brightdata-persisted-canary SELENA_BRIGHTDATA_PERSISTED_CANARY_ENABLED=true tsx src/scripts/measure-journal-entrypoint.ts",
		"canary:brightdata-response": "tsx src/scripts/brightdata-response-canary.ts",
		"canary:dataforseo-perplexity": "tsx src/scripts/dataforseo-perplexity-canary.ts",
		"canary:google-ai-mode": "tsx src/scripts/google-ai-mode-dataset-canary.ts",
		"reconcile:google-ai-mode-historical": "tsx src/scripts/reconcile-google-ai-mode-historical-snapshot.ts",
		"measure:journal": "tsx src/scripts/measure-journal-entrypoint.ts"
	},
	"dependencies": {
		"@sentry/node": "^10.75.2",
		"@workspace/cloud": "workspace:*",
		"@workspace/config": "workspace:*",
		"@workspace/deployment": "workspace:*",
		"@workspace/lib": "workspace:*",
		"@workspace/whitelabel": "workspace:*",
		"auth0": "^6.1.0",
		"drizzle-orm": "^0.45.3",
		"pg": "^8.23.0",
		"pg-boss": "^12.33.5",
		"posthog-node": "^5.52.5"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"@types/pg": "^8.23.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
